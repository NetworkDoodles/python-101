# The lab's settings and secrets. `make setup` copies this file to .env, which Git ignores (.gitignore),
# so the password and the token never end up in a commit. netlab/env.py reads .env into the environment.
#
# These are lab values, the same for everyone. A real network's go in .env too, never in code.
LAB_USER=admin
LAB_PASSWORD=capeos-lab
LAB_API_URL=http://api:8000
LAB_API_TOKEN=0123456789abcdef0123456789abcdef01234567
